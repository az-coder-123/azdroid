<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for Contents/MacOS/azdroid-mcp (the precompiled MCP server).
  Dart AOT executables map their snapshot as executable memory. Under the
  hardened runtime this is the minimal entitlement that lets them start;
  allow-jit alone is not enough (the process is killed with SIGKILL).
  See docs/lessons-learned/dart-aot-hardened-runtime.md.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
</dict>
</plist>
