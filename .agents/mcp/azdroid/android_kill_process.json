{
  "name": "android_kill_process",
  "description": "Terminates an active process by its numeric PID or package name.",
  "parameters": {
    "type": "object",
    "properties": {
      "deviceSerial": {
        "type": "string",
        "description": "Target device serial."
      },
      "pid": {
        "type": "integer",
        "description": "Numeric process ID (PID) to kill."
      },
      "package": {
        "type": "string",
        "description": "Package name to terminate if PID is unknown."
      }
    },
    "anyOf": [
      {
        "required": [
          "pid"
        ]
      },
      {
        "required": [
          "package"
        ]
      }
    ]
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": true,
    "idempotentHint": false
  }
}
