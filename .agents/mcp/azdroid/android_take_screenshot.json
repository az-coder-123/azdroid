{
  "name": "android_take_screenshot",
  "description": "Captures the screen as PNG or JPEG. Optionally crops it to save tokens: give x/y/width/height in pixels, or xRatio/yRatio/widthRatio/heightRatio as screen fractions (all four of one kind). Omit them for the full screen.",
  "parameters": {
    "type": "object",
    "properties": {
      "deviceSerial": {
        "type": "string",
        "description": "Device serial or IP:port from android_list_devices. Required when several devices are connected; may be omitted when only one is."
      },
      "x": {
        "type": "number",
        "description": "Crop left edge in pixels."
      },
      "y": {
        "type": "number",
        "description": "Crop top edge in pixels."
      },
      "width": {
        "type": "number",
        "description": "Crop width in pixels."
      },
      "height": {
        "type": "number",
        "description": "Crop height in pixels."
      },
      "xRatio": {
        "type": "number",
        "description": "Crop origin X ratio (0.0 to 1.0)."
      },
      "yRatio": {
        "type": "number",
        "description": "Crop origin Y ratio (0.0 to 1.0)."
      },
      "widthRatio": {
        "type": "number",
        "description": "Crop width ratio (0.0 to 1.0)."
      },
      "heightRatio": {
        "type": "number",
        "description": "Crop height ratio (0.0 to 1.0)."
      },
      "format": {
        "type": "string",
        "enum": [
          "png",
          "jpeg",
          "jpg"
        ],
        "description": "Output image format (default png)."
      },
      "quality": {
        "type": "integer",
        "description": "JPEG compression quality from 1 to 100 (default 80)."
      }
    }
  },
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true
  }
}
