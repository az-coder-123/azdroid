{
  "name": "android_set_volume",
  "description": "Adjusts audio volume level (stream: 1=System, 2=Ring, 3=Music/Media, 4=Alarm, 5=Notification).",
  "parameters": {
    "type": "object",
    "properties": {
      "deviceSerial": {
        "type": "string",
        "description": "Device serial or IP:port from android_list_devices. Required when several devices are connected; may be omitted when only one is."
      },
      "stream": {
        "type": "integer",
        "description": "Audio stream type (1=System, 2=Ring, 3=Music/Media, 4=Alarm, 5=Notification). Default 3."
      },
      "volumeIndex": {
        "type": "integer",
        "description": "Volume index level (typically 0 to 15 or 25)."
      }
    },
    "required": [
      "volumeIndex"
    ]
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": true
  }
}
