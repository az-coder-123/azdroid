{
  "name": "android_dispatch_intent",
  "description": "Fires an Android Intent, custom URL scheme, or deep link with optional package and typed extras.",
  "parameters": {
    "type": "object",
    "properties": {
      "deviceSerial": {
        "type": "string",
        "description": "Device serial or IP:port from android_list_devices. Required when several devices are connected; may be omitted when only one is."
      },
      "action": {
        "type": "string",
        "description": "Intent action (e.g., android.intent.action.VIEW)."
      },
      "dataUri": {
        "type": "string",
        "description": "Data URI or web URL."
      },
      "package": {
        "type": "string",
        "description": "Target application package name."
      },
      "component": {
        "type": "string",
        "description": "Explicit target component class."
      },
      "extras": {
        "type": "object",
        "description": "Key-value map of intent extras."
      }
    },
    "required": [
      "action"
    ]
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": false
  }
}
