{
  "name": "android_swipe",
  "description": "Performs a swipe or drag gesture between two coordinates on the Android device.",
  "parameters": {
    "type": "object",
    "properties": {
      "deviceSerial": {
        "type": "string",
        "description": "Target device serial or IP:port."
      },
      "startX": {
        "type": "number",
        "description": "Coordinate (normalized 0.0-1.0 or pixels)."
      },
      "startY": {
        "type": "number",
        "description": "Coordinate (normalized 0.0-1.0 or pixels)."
      },
      "endX": {
        "type": "number",
        "description": "Coordinate (normalized 0.0-1.0 or pixels)."
      },
      "endY": {
        "type": "number",
        "description": "Coordinate (normalized 0.0-1.0 or pixels)."
      },
      "durationMs": {
        "type": "integer",
        "description": "Duration of the swipe in ms (default 300ms)."
      }
    },
    "required": [
      "startX",
      "startY",
      "endX",
      "endY"
    ]
  }
}