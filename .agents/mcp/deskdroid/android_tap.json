{
  "name": "android_tap",
  "description": "Simulates a touch tap gesture at normalized coordinates (0.0 to 1.0) on the Android screen.",
  "parameters": {
    "type": "object",
    "properties": {
      "deviceSerial": {
        "type": "string",
        "description": "Target device serial or IP:port."
      },
      "x": {
        "type": "number",
        "description": "Coordinate (normalized 0.0-1.0 or pixels)."
      },
      "y": {
        "type": "number",
        "description": "Coordinate (normalized 0.0-1.0 or pixels)."
      }
    },
    "required": [
      "x",
      "y"
    ]
  }
}